# Copiez ce fichier vers .env (jamais commité) et remplissez les valeurs.

# Secret de signature des cookies de session admin.
# Générez-en un avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port d'écoute du serveur (API + tableau de bord + signalisation WebSocket).
PORT=3000

# Mettre à "production" une fois servi derrière HTTPS (active le cookie "secure").
NODE_ENV=development
